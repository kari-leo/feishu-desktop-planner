# ============================================================================
# Feishu Desktop Planner —— 环境变量示例
# 复制为 .env 后填入真实值（.env 已被 .gitignore 忽略，不会进仓库）
#   PowerShell:  Copy-Item .env.example .env
# ============================================================================

# ---- 必填：飞书应用身份 ----
# 飞书开放平台 → 你的自建应用 → 凭证与基础信息
FEISHU_APP_ID=
# App Secret：仅用于首次授权换取用户 token；授权后加密存于 data/*.dpapi
FEISHU_APP_SECRET=

# ---- 必填：多维表格 ----
# 多维表格 URL 中 /base/ 后那一段（base app token）
FEISHU_BASE_APP_TOKEN=
# 排期表 table_id（URL 中 ?table= 后那一段，以 tbl 开头）
FEISHU_SCHEDULE_TABLE_ID=
# 待办表 table_id
FEISHU_TODO_TABLE_ID=

# ---- 必填：共享日历 ----
# 日历 ID，形如 feishu.cn_xxx@group.calendar.feishu.cn
FEISHU_CALENDAR_ID=

# ---- 可选：时区与同步节奏 ----
# 默认 Asia/Shanghai
FEISHU_TIMEZONE=Asia/Shanghai
# 轮询间隔（秒），取值 15–3600，默认 300
FEISHU_POLL_SECONDS=300
# 设为 0 关闭 WebSocket 长连接（仅靠轮询）
FEISHU_WEBSOCKET=1

# ---- 可选：本地数据与授权回调 ----
# 本地数据目录（SQLite、加密凭据），默认 ./data
FEISHU_DATA_DIR=data
# OAuth 回调地址，需与飞书应用「重定向 URL」一致
FEISHU_OAUTH_REDIRECT=http://127.0.0.1:8765/oauth/callback
# 申请的权限范围，默认 calendar:calendar offline_access
FEISHU_OAUTH_SCOPES=calendar:calendar offline_access

# ---- 可选：字段映射与状态（留空则用内置默认值）----
# 形如 逻辑名=表格列名，多个用逗号分隔
FEISHU_SCHEDULE_FIELDS=
FEISHU_TODO_FIELDS=
# 视为「已取消」的状态值，逗号分隔
FEISHU_CANCELLED_STATES=
